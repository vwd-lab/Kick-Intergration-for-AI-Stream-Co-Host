# ---------------------------------------------------------------------------
# .env.example - copy to .env and fill in YOUR values. Never commit .env.
# ---------------------------------------------------------------------------

# --- REQUIRED ---
# Your Kick channel slug: the part after https://kick.com/ (lowercase).
KICK_CHANNEL=yourchannelslug

# --- RECEIVER ---
# Local port the webhook receiver listens on. Kick POSTs from its own servers,
# so this must be exposed through a public HTTPS tunnel.
KICK_WEBHOOK_PORT=8770

# Public https URL of that tunnel, e.g. https://random-words.trycloudflare.com
# Leave blank until you have started a tunnel; the demo will tell you.
KICK_WEBHOOK_URL=

# How often to check that the public URL still reaches the receiver (seconds).
KICK_WEBHOOK_HEALTH_S=30

# Where kick_tunnel_host.py writes the current quick-tunnel hostname.
# Relative paths resolve against this folder, not the current directory.
KICK_TUNNEL_URL_FILE=data/kick_tunnel_url.txt

# --- CHAT FORMATTING ---
# Messages starting with this prefix are formatted as questions ("asks"):
#   !ask what is this  ->  [Kick viewer 'kick:name' asks]: what is this
# Every other message is forwarded as "says". The receiver does not gate.
KICK_COMMAND_PREFIX=!ask

# --- TEXT REPLIES (optional) ---
# 1 = the demo is allowed to post replies back into Kick chat.
# Requires an authorized bot account (see README step 5).
KICK_TEXT_REPLIES=0

# From your Kick app (developer dashboard).
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# Where setup_kick_auth.py saves the token pair (auto-refreshed).
# Relative paths resolve against this folder.
KICK_TOKENS_FILE=kick_tokens.json

# Minimum seconds between outgoing messages.
KICK_SEND_INTERVAL_S=2.0

# --- SAFETY ---
# Username of the account the bot posts as. Used to sanity-check OAuth and,
# when set, to ignore the bot's own messages if Kick echoes them back.
KICK_BOT_ACCOUNT=

# Extra usernames to ignore entirely (comma-separated, case-insensitive).
KICK_IGNORED_USERS=
